# Local API and frontend development ports.
PORT=4173
API_PORT=4173
VITE_PORT=5173
BASE_PATH=/

# PostgreSQL. Use a dedicated test database whose name includes "test".
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55439/expense_tracker_test

# Supabase Auth: copy Project URL and Publishable key from your Supabase project.
# The VITE_ values go to the browser; the server values are used to verify sessions.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_KEY
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_KEY

# Optional CORS origin for a separately hosted API. Leave unset for same-origin Vercel.
APP_ORIGIN=

# Optional backend log verbosity (defaults to info).
LOG_LEVEL=info
