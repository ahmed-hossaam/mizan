# Local API and frontend development ports.
PORT=4173
API_PORT=4173
VITE_PORT=5173
BASE_PATH=/

# PostgreSQL. Use a dedicated test database whose name includes "test".
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55439/expense_tracker_test

# Clerk: use the same instance's publishable key on client and server.
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_CLERK_SECRET_KEY
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_CLERK_PUBLISHABLE_KEY

# Optional; only set for a configured Clerk proxy.
VITE_CLERK_PROXY_URL=

# Optional CORS origin for a separately hosted API. Leave unset for same-origin Vercel.
APP_ORIGIN=
